# ==============================================================================
# TOEIC PRO PORTAL - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# [Local Development / Docker]
# Standard direct connection to local PostgreSQL instance
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/toeic_pro?schema=public"

# [Neon / Supabase Serverless Setup]
# For serverless environments like Neon, use connection pooling for application queries:
# DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/toeic_pro?sslmode=require&pgbouncer=true"
# And use DIRECT_URL for Prisma migrations / db push (bypassing PgBouncer):
# DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/toeic_pro?sslmode=require"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
# Generate strong 64-character secrets for production (e.g. openssl rand -base64 48)
JWT_SECRET="replace-with-a-very-strong-jwt-secret-for-production-min-32-chars"
JWT_REFRESH_SECRET="replace-with-a-very-strong-jwt-refresh-secret-for-production-min-32-chars"

# ------------------------------------------------------------------------------
# 3. APPLICATION URL & CORS
# ------------------------------------------------------------------------------
# Local: http://localhost:3000 (or http://localhost:3005)
# Production: https://toeicpro.yourdomain.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. OPTIONAL SERVERLESS ECOSYSTEM INTEGRATIONS
# ------------------------------------------------------------------------------
# Asset Storage (Cloudflare R2 / AWS S3 / Vercel Blob) - For TOEIC Listening MP3s & Images
# NEXT_PUBLIC_STORAGE_CDN_URL="https://assets.toeicpro.com"
# S3_BUCKET_NAME="toeic-pro-assets"
# S3_REGION="auto"
# S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
# S3_ACCESS_KEY_ID="your_r2_access_key"
# S3_SECRET_ACCESS_KEY="your_r2_secret_key"

# Cache & Rate Limiting (Upstash Redis)
# UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your_upstash_token"
