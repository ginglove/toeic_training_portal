{
  "name": "toeic-pro-portal",
  "version": "10.0.0",
  "private": true,
  "description": "TOEIC PRO - Adaptive 30-Day TOEIC Training Portal (100% Free & Open Access)",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "test": "npx tsx --test \"tests/**/*.test.ts\"",
    "test:unit": "npx tsx --test \"tests/unit/*.test.ts\"",
    "test:security": "npx tsx --test \"tests/security/*.test.ts\"",
    "test:e2e": "npx tsx --test \"tests/e2e/*.test.ts\"",
    "test:ui": "npx tsx --test \"tests/ui-ux/*.test.ts\"",
    "test:api": "npx tsx --test \"tests/api/*.test.ts\"",
    "sync:drive": "bash scripts/sync-requirements-drive.sh",
    "watch:drive": "node scripts/watch-requirements.js"
  },

  "dependencies": {
    "@prisma/client": "^5.10.2",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.354.0",
    "next": "14.2.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.2.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "prisma": "^5.10.2",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3"
  }
}